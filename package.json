{
  "name": "termux-coding-learn",
  "version": "1.1.0",
  "description": "Learn Termux commands & coding skills offline",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "framer-motion": "^10.16.0",
    "lucide-react": "^0.294.0",
    "localforage": "^1.10.0",
    "jszip": "^3.10.1",
    "file-saver": "^2.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "@capacitor/core": "^5.6.0",
    "@capacitor/android": "^5.6.0",
    "@capacitor/cli": "^5.6.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "build": {
    "appId": "com.iminthisera.termuxlearn",
    "productName": "Termux Coding Learn",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "electron/**/*", "node_modules/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
