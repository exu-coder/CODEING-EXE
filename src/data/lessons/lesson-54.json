{"level":54,"level_name":"JavaScript Async","difficulty":"advanced","required_score":70,"total_exercises":5,"exercises":[{"id":"L54-E1","type":"code","category":"javascript","instruction":"Create a resolved promise","shadow_text":"const ready = Promise.resolve('ready')","expected_output":[],"hint":"Promise.resolve creates an already fulfilled promise.","time_limit":25,"xp":30,"penalty_per_error":2},{"id":"L54-E2","type":"code","category":"javascript","instruction":"Create an async function","shadow_text":"async function boot() {\n  return 'online'\n}","expected_output":[],"hint":"Use async before function.","time_limit":28,"xp":35,"penalty_per_error":3},{"id":"L54-E3","type":"code","category":"javascript","instruction":"Await boot","shadow_text":"boot().then(console.log)","expected_output":["online"],"hint":"Use then to consume the promise.","time_limit":25,"xp":35,"penalty_per_error":2},{"id":"L54-E4","type":"code","category":"javascript","instruction":"Create a promise with timeout zero","shadow_text":"const task = new Promise(resolve => resolve('done'))","expected_output":[],"hint":"Call resolve inside the executor.","time_limit":30,"xp":40,"penalty_per_error":3},{"id":"L54-E5","type":"code","category":"javascript","instruction":"Log the task result","shadow_text":"task.then(console.log)","expected_output":["done"],"hint":"Attach a then handler.","time_limit":22,"xp":30,"penalty_per_error":2}]}