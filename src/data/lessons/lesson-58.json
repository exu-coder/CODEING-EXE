{"level":58,"level_name":"Bash Loops","difficulty":"expert","required_score":70,"total_exercises":5,"exercises":[{"id":"L58-E1","type":"command","category":"bash","instruction":"Create a for loop","shadow_text":"for n in 1 2 3; do\n  echo $n\ndone","expected_output":["1","2","3"],"hint":"A Bash for loop ends with done.","time_limit":30,"xp":40,"penalty_per_error":3},{"id":"L58-E2","type":"command","category":"bash","instruction":"Create a while loop","shadow_text":"n=1\nwhile [ $n -le 3 ]; do\n  echo $n\n  n=$((n + 1))\ndone","expected_output":["1","2","3"],"hint":"Update n inside the loop.","time_limit":40,"xp":50,"penalty_per_error":3},{"id":"L58-E3","type":"command","category":"bash","instruction":"Loop over source files","shadow_text":"for file in src/*.js; do\n  echo $file\ndone","expected_output":["src/app.js"],"hint":"Use a glob pattern.","time_limit":35,"xp":45,"penalty_per_error":3},{"id":"L58-E4","type":"command","category":"bash","instruction":"Break a loop","shadow_text":"for n in 1 2 3; do\n  [ $n -eq 3 ] && break\n  echo $n\ndone","expected_output":["1","2"],"hint":"break exits the loop.","time_limit":35,"xp":45,"penalty_per_error":3},{"id":"L58-E5","type":"command","category":"bash","instruction":"Skip one iteration","shadow_text":"for n in 1 2 3; do\n  [ $n -eq 2 ] && continue\n  echo $n\ndone","expected_output":["1","3"],"hint":"continue skips to the next iteration.","time_limit":35,"xp":45,"penalty_per_error":3}]}