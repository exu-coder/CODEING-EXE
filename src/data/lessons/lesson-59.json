{"level":59,"level_name":"Git Workflow","difficulty":"expert","required_score":70,"total_exercises":5,"exercises":[{"id":"L59-E1","type":"command","category":"git","instruction":"Check repository status","shadow_text":"git status","expected_output":["On branch main"],"hint":"status shows changed files and branch information.","time_limit":15,"xp":20,"penalty_per_error":2},{"id":"L59-E2","type":"command","category":"git","instruction":"Create a feature branch","shadow_text":"git switch -c feature/level-up","expected_output":["Switched to a new branch 'feature/level-up'"],"hint":"switch -c creates and switches to a branch.","time_limit":25,"xp":35,"penalty_per_error":2},{"id":"L59-E3","type":"command","category":"git","instruction":"Stage all changes","shadow_text":"git add .","expected_output":[],"hint":"A dot means the current directory.","time_limit":15,"xp":20,"penalty_per_error":2},{"id":"L59-E4","type":"command","category":"git","instruction":"Commit the changes","shadow_text":"git commit -m 'Add level'","expected_output":["[feature/level-up] Add level"],"hint":"Use -m followed by a commit message.","time_limit":25,"xp":35,"penalty_per_error":2},{"id":"L59-E5","type":"command","category":"git","instruction":"Push the feature branch","shadow_text":"git push -u origin feature/level-up","expected_output":["branch 'feature/level-up' set up to track"],"hint":"-u sets the upstream branch.","time_limit":30,"xp":40,"penalty_per_error":3}]}