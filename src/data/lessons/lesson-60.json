{"level":60,"level_name":"Final Boss: Build a CLI","difficulty":"expert","required_score":80,"total_exercises":5,"exercises":[{"id":"L60-E1","type":"code","category":"python","instruction":"Create a command parser function","shadow_text":"def parse(command):\n    return command.strip().lower()","expected_output":[],"hint":"Normalize the incoming command.","time_limit":30,"xp":45,"penalty_per_error":3},{"id":"L60-E2","type":"code","category":"python","instruction":"Parse a status command","shadow_text":"print(parse(' STATUS '))","expected_output":["status"],"hint":"strip removes spaces and lower normalizes case.","time_limit":22,"xp":35,"penalty_per_error":2},{"id":"L60-E3","type":"code","category":"python","instruction":"Handle a command with a condition","shadow_text":"command = parse(' HELP ')\nif command == 'help':\n    print('Available commands')","expected_output":["Available commands"],"hint":"Compare the normalized command.","time_limit":35,"xp":50,"penalty_per_error":3},{"id":"L60-E4","type":"code","category":"python","instruction":"Add an unknown command branch","shadow_text":"if command == 'help':\n    print('Available commands')\nelse:\n    print('Unknown command')","expected_output":["Available commands"],"hint":"Use else for commands you do not recognize.","time_limit":35,"xp":50,"penalty_per_error":3},{"id":"L60-E5","type":"code","category":"python","instruction":"Build the final CLI response","shadow_text":"commands = ['help', 'status', 'exit']\nfor item in commands:\n    print(item)","expected_output":["help","status","exit"],"hint":"Combine a list and loop to display commands.","time_limit":40,"xp":60,"penalty_per_error":3}]}